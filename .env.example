# Copy this file to `.env` on each machine, then keep only the section that machine needs.

# Shared Firebase settings.
NEJE_FIREBASE_PROJECT_ID=your-project-id
NEJE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEJE_FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
NEJE_GALLERY_BASE_URL=https://your-user.github.io/neje-oracle-gallery

# Oracle Mac mini: uploader only.
NEJE_UPLOADER_SESSION_ROOT=/absolute/path/to/sessions_raw
NEJE_UPLOADER_PUBLIC_ROOT=/absolute/path/to/sessions_public
NEJE_UPLOADER_DB_PATH=/absolute/path/to/runtime/uploader.sqlite3
NEJE_UPLOADER_POLL_SECONDS=2.0
NEJE_UPLOADER_STABILITY_SECONDS=8.0
NEJE_UPLOADER_READY_MARKER=READY
NEJE_UPLOADER_REQUIRE_READY_MARKER=false

# Plotter MacBook: print daemon only.
NEJE_PLOTTER_DB_PATH=/absolute/path/to/runtime/plotter.sqlite3
NEJE_PLOTTER_PLACEHOLDER_ROOT=/absolute/path/to/placeholders
NEJE_PLOTTER_SPOOL_ROOT=/absolute/path/to/spool
NEJE_PLOTTER_POLL_SECONDS=4.0
NEJE_PLOTTER_SHEET_WIDTH_MM=594
NEJE_PLOTTER_SHEET_HEIGHT_MM=841
NEJE_PLOTTER_SHEET_MARGIN_MM=24
NEJE_PLOTTER_CELL_DIAMETER_MM=160
NEJE_PLOTTER_SHEET_CAPACITY=7
NEJE_PLOTTER_SAMPLE_STEP_MM=3.0
NEJE_PLOTTER_TRAVEL_RATE=5000
NEJE_PLOTTER_DRAW_RATE=1800
NEJE_PLOTTER_PEN_UP=M5
NEJE_PLOTTER_PEN_DOWN=M3 S15
NEJE_PLOTTER_DRY_RUN=true
NEJE_PLOTTER_FLUIDNC_HOST=fluidnc.local
NEJE_PLOTTER_FLUIDNC_PORT=23
NEJE_PLOTTER_OPERATOR_HOST=0.0.0.0
NEJE_PLOTTER_OPERATOR_PORT=8765

