# MacBook near the plotter: plotter daemon only.

NEJE_FIREBASE_PROJECT_ID=your-project-id
NEJE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEJE_FIREBASE_CREDENTIALS=/Users/your-user/Secrets/serviceAccountKey.json
NEJE_GUI_HOST=127.0.0.1
NEJE_GUI_PORT=8787
NEJE_ORACLE_RUNTIME_DB_PATH=/Users/your-user/NejeOracle/runtime/oracle_runtime.sqlite3
NEJE_ORACLE_LOGS_ROOT=/Users/your-user/NejeOracle/logs
NEJE_MACMINI_AGENT_URL=http://macmini.local:8790
NEJE_MACMINI_AGENT_TIMEOUT_SECONDS=2.0

NEJE_PLOTTER_DB_PATH=/Users/your-user/NejeOracle/runtime/plotter.sqlite3
NEJE_PLOTTER_PLACEHOLDER_ROOT=/Users/your-user/NejeOracle/assets/symbols
NEJE_PLOTTER_SPOOL_ROOT=/Users/your-user/NejeOracle/spool
NEJE_PLOTTER_POLL_SECONDS=4.0
NEJE_PLOTTER_SHEET_WIDTH_MM=250
NEJE_PLOTTER_SHEET_HEIGHT_MM=440
NEJE_PLOTTER_SHEET_MARGIN_MM=0
NEJE_PLOTTER_CELL_DIAMETER_MM=80
NEJE_PLOTTER_CELL_GAP_MM=0
NEJE_PLOTTER_LAYOUT_MODE=hex
NEJE_PLOTTER_SAMPLE_STEP_MM=3.0
NEJE_PLOTTER_TRAVEL_RATE=5000
NEJE_PLOTTER_DRAW_RATE=1800
NEJE_PLOTTER_PEN_UP=M5
NEJE_PLOTTER_PEN_DOWN="M3 S15"
NEJE_PLOTTER_DRY_RUN=true
NEJE_PLOTTER_FLUIDNC_HOST=fluidnc.local
NEJE_PLOTTER_FLUIDNC_PORT=23
NEJE_PLOTTER_OPERATOR_HOST=0.0.0.0
NEJE_PLOTTER_OPERATOR_PORT=8765
