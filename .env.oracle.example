# Mac mini with TouchDesigner: uploader only.

NEJE_FIREBASE_PROJECT_ID=your-project-id
NEJE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEJE_FIREBASE_CREDENTIALS=/Users/your-user/Secrets/serviceAccountKey.json
NEJE_GALLERY_BASE_URL=https://your-user.github.io/neje-oracle-gallery

NEJE_UPLOADER_SESSION_ROOT=/Users/your-user/TouchDesigner/sessions_raw
NEJE_UPLOADER_PUBLIC_ROOT=/Users/your-user/NejeOracle/sessions_public
NEJE_UPLOADER_DB_PATH=/Users/your-user/NejeOracle/runtime/uploader.sqlite3
NEJE_UPLOADER_POLL_SECONDS=2.0
NEJE_UPLOADER_STABILITY_SECONDS=8.0
NEJE_UPLOADER_READY_MARKER=READY
NEJE_UPLOADER_REQUIRE_READY_MARKER=false

